.PHONY: all debug release build-sdl3 build-sdl3-mixer verify-sdl3 verify-sdl3-mixer

# Build type: release (default) or debug
# Usage: make BUILD_TYPE=debug
BUILD_TYPE ?= release

all: bin/moac

CC=clang
EXTRA_ARCH_FLAGS ?=
ifneq (,$(findstring znver4,$(EXTRA_ARCH_FLAGS)))
RUST_CPU_FLAGS=-C target-cpu=znver4
else
RUST_CPU_FLAGS=
endif
# Get SDL3 flags and convert -I to -isystem to suppress warnings from SDL headers
SDL_CFLAGS_RAW=$(shell pkg-config sdl3 --cflags)
SDL_CFLAGS=$(patsubst -I%,-isystem %,$(SDL_CFLAGS_RAW))

# SDL3_ttf is OPTIONAL: when present the client gains the experimental TTF
# text path (Options > Display > TTF Text). Without it, font_manager.c
# compiles to inert stubs and the bitmap fonts are used unconditionally.
HAS_SDL3_TTF := $(shell pkg-config --exists sdl3-ttf 2>/dev/null && echo 1)
ifeq ($(HAS_SDL3_TTF),1)
SDL_TTF_CFLAGS_RAW=$(shell pkg-config sdl3-ttf --cflags)
SDL_TTF_CFLAGS=-DHAVE_SDL3_TTF $(patsubst -I%,-isystem %,$(SDL_TTF_CFLAGS_RAW))
SDL_TTF_LIBS=$(shell pkg-config sdl3-ttf --libs)
$(info SDL3_ttf found - building with TTF text support)
else
SDL_TTF_CFLAGS=
SDL_TTF_LIBS=
$(info SDL3_ttf not found - building without TTF text support (optional))
endif

# Build type configuration
ifeq ($(BUILD_TYPE),debug)
    OPT=-O0
    DEBUG=-gdwarf-4 -g3
    DEVELOPER_FLAGS=-DDEVELOPER
    $(info Building DEBUG configuration)
else
    OPT=-O3
    DEBUG=-gdwarf-4
    DEVELOPER_FLAGS=-DNDEBUG
    $(info Building RELEASE configuration)
endif

STRICT_WARNING_FLAGS = \
    -Wall -Wextra -Wpedantic \
    -Wformat=2 \
    -Wnull-dereference \
    -Wdouble-promotion \
    -Wcast-align \
    -Wcast-qual \
    -Wconversion -Wsign-conversion \
    -Wmissing-prototypes -Wstrict-prototypes \
    -Wvla \
    -Wfloat-equal \
    -Wnewline-eof

WARNING_FLAGS ?= $(STRICT_WARNING_FLAGS) -Werror

# Default to using mimalloc unless USE_MIMALLOC=0 is set
USE_MIMALLOC ?= 1

# LuaJIT scripting support (enabled by default, disable with USE_LUAJIT=0)
USE_LUAJIT ?= 1
# Escape hatch: LUA_ALLOW_JIT=1 lets mod states JIT-compile (faster, but the
# instruction watchdog cannot interrupt JIT-compiled hot loops - see mods/README.md)
LUA_ALLOW_JIT ?= 0
ifeq ($(USE_LUAJIT),1)
LUAJIT_CFLAGS_RAW=$(shell pkg-config --cflags luajit 2>/dev/null || echo "-I/usr/include/luajit-2.1")
LUAJIT_CFLAGS=-DUSE_LUAJIT=1 $(patsubst -I%,-isystem %,$(LUAJIT_CFLAGS_RAW))
ifeq ($(LUA_ALLOW_JIT),1)
LUAJIT_CFLAGS += -DLUA_SCRIPTING_ALLOW_JIT
endif
LUAJIT_LIBS=$(shell pkg-config --libs luajit 2>/dev/null || echo "-lluajit-5.1")
$(info LuaJIT scripting enabled (USE_LUAJIT=1))
else
LUAJIT_CFLAGS=
LUAJIT_LIBS=
$(info LuaJIT scripting disabled (USE_LUAJIT=0))
endif

CFLAGS=$(OPT) $(DEBUG) $(WARNING_FLAGS) $(DEVELOPER_FLAGS) -fno-omit-frame-pointer -fvisibility=hidden $(SDL_CFLAGS) $(SDL_TTF_CFLAGS) $(LUAJIT_CFLAGS) $(EXTRA_ARCH_FLAGS) -Iinclude -Isrc -DUSE_MIMALLOC=$(USE_MIMALLOC) -DSDL_FUNCTION_POINTER_IS_VOID_POINTER
CFLAGS_PIC=$(OPT) $(DEBUG) $(WARNING_FLAGS) $(DEVELOPER_FLAGS) -fPIC -fno-omit-frame-pointer -fvisibility=hidden $(SDL_CFLAGS) $(SDL_TTF_CFLAGS) $(LUAJIT_CFLAGS) $(EXTRA_ARCH_FLAGS) -Iinclude -Isrc -DUSE_MIMALLOC=$(USE_MIMALLOC) -DSDL_FUNCTION_POINTER_IS_VOID_POINTER
LDFLAGS=$(OPT) $(DEBUG) -rdynamic -Wl,-rpath,\$$ORIGIN

SDL_LIBS=$(shell pkg-config sdl3 --libs)
LIBS = -lz -lpng -lzip $(SDL_LIBS) $(SDL_TTF_LIBS) -lSDL3_mixer -lm $(LUAJIT_LIBS)
ifeq ($(USE_MIMALLOC),1)
LIBS += -lmimalloc
endif

ASTONIA_NET_DIR=astonia_net
ASTONIA_NET_TGT=x86_64-unknown-linux-gnu
ASTONIA_NET_LIB=$(ASTONIA_NET_DIR)/target/$(ASTONIA_NET_TGT)/release/libastonia_net.so

OBJS	=		src/gui/gui_core.o src/gui/gui_input.o src/gui/gui_display.o src/gui/gui_inventory.o src/gui/gui_buttons.o src/gui/gui_map.o\
			src/client/client.o src/client/protocol.o src/client/skill.o\
			src/game/game_core.o src/game/game_effects.o src/game/game_lighting.o src/game/game_display.o\
			src/game/render.o src/game/font.o src/game/main.o src/game/sprite.o src/game/sprite_config.o\
			src/game/memory.o\
			src/modder/modder.o\
			src/sdl/sdl_core.o src/sdl/sdl_texture.o src/sdl/sdl_image.o src/sdl/sdl_effects.o src/sdl/sdl_draw.o src/sdl/sdl_gpu.o src/sdl/sdl_gpu_post.o src/sdl/sdl_gpu_batch.o src/sdl/sdl_gpu_shaderfx.o src/sdl/sdl_gpu_atlas.o src/sdl/sdl_gpu_text.o src/sdl/sdl_text_glyph.o src/sdl/sdl_gpu_draw.o src/sdl/font_manager.o src/sdl/gamepad.o src/sdl/sound.o\
			src/helper/helper.o\
			src/gui/dots.o src/gui/display.o src/gui/teleport.o src/gui/color.o src/gui/cmd.o\
			src/gui/questlog.o src/gui/context.o src/gui/hover.o src/gui/minimap.o src/gui/input_bind.o src/gui/hotbar_ui.o src/gui/spellbook_ui.o src/gui/keybind_ui.o src/gui/keybind_settings_ui.o src/gui/escape_menu_ui.o src/gui/options_ui.o src/gui/loading_ui.o src/gui/ui_draw.o src/gui/panels.o\
			src/game/memory_linux.o src/game/version.o\
			src/lib/cjson/cJSON.o

# Add Lua scripting objects if enabled
ifeq ($(USE_LUAJIT),1)
OBJS += src/scripting/lua_core.o src/scripting/lua_api.o
endif

bin/moac:	verify-sdl3-mixer $(OBJS) $(ASTONIA_NET_LIB)
		mkdir -p bin
		cp $(ASTONIA_NET_LIB) bin/
		$(CC) $(LDFLAGS) -o bin/moac $(OBJS) $(LIBS) -Lbin -lastonia_net

$(ASTONIA_NET_LIB):
		rustup target add $(ASTONIA_NET_TGT)
		cd $(ASTONIA_NET_DIR) && RUSTFLAGS="$(RUST_CPU_FLAGS)" cargo build --release --target $(ASTONIA_NET_TGT)

bin/amod.so:	src/amod/amod.o bin/moac
		$(CC) $(LDFLAGS) -shared -o bin/amod.so src/amod/amod.o

src/amod/amod.o:	src/amod/amod.c src/amod/amod.h src/amod/amod_structs.h
		$(CC) $(CFLAGS_PIC) -c -o $@ $<

bin/anicopy:	src/helper/anicopy.c
		$(CC) $(OPT) $(DEBUG) -Wall -o bin/anicopy src/helper/anicopy.c

bin/convert:	src/helper/convert.c
		$(CC) $(OPT) $(DEBUG) -Wall -DSTANDALONE -DUSE_MIMALLOC=$(USE_MIMALLOC) -o bin/convert src/helper/convert.c -lpng -lzip $(if $(filter 1,$(USE_MIMALLOC)),-lmimalloc,)



clean:
	@echo "Cleaning build artifacts..."
	-rm -f src/*/*.o src/*/*-sanitizer.o src/*/*-coverage.o
	-rm -f bin/moac bin/moac-sanitizer bin/moac-coverage
	-rm -f bin/*.so bin/convert bin/anicopy
	@echo "Cleaning coverage files..."
	-find . -type f -name '*.gcda' -delete
	-find . -type f -name '*.gcno' -delete
	-find . -type f -name '*.gcov' -delete
	-find . -type f -name '*.gcov.json.gz' -delete
	-rm -f coverage.info coverage-filtered.info
	-rm -rf coverage-html
	@echo "Cleaning profiling data..."
	-find . -type f -name '*.profraw' -delete
	-find . -type f -name '*.profdata' -delete
	@echo "Cleaning analysis reports..."
	-rm -f compile_commands.json
	-rm -f valgrind-report.txt
	-rm -f asan-report.txt.*
	-rm -f ubsan-report.txt.*
	-rm -f .clang-tidy-*
	@echo "Cleaning Rust artifacts..."
	-rm -rf astonia_net/target
	@echo "Cleaning distribution artifacts..."
	-rm -rf distrib
	-rm -f linux_client.tar.gz

# Prepare distribution staging directory (bundles shared library dependencies)
distrib-stage:
	@echo "Preparing Linux distribution staging..."
	@bash build/tools/package_linux.sh

# Legacy target for local development (creates archive)
distrib: distrib-stage
	@echo "Creating distribution archive..."
	@cd distrib && tar czf ../linux_client.tar.gz linux_client
	@echo "Distribution package created: linux_client.tar.gz"

amod:		bin/amod.so bin/moac
convert:	bin/convert
anicopy:	bin/anicopy

# Code quality builds
SANITIZER_FLAGS=-fsanitize=address,undefined -fno-omit-frame-pointer -g
COVERAGE_FLAGS=--coverage -fprofile-arcs -ftest-coverage

OBJS_SANITIZER=$(OBJS:.o=-sanitizer.o)
OBJS_COVERAGE=$(OBJS:.o=-coverage.o)

sanitizer: bin/moac-sanitizer

bin/moac-sanitizer: USE_MIMALLOC=0
bin/moac-sanitizer: $(OBJS_SANITIZER) $(ASTONIA_NET_LIB)
	cp $(ASTONIA_NET_LIB) bin/
	$(CC) $(LDFLAGS) $(SANITIZER_FLAGS) -o bin/moac-sanitizer $(OBJS_SANITIZER) $(filter-out -lmimalloc,$(LIBS)) -Lbin -lastonia_net

%-sanitizer.o: USE_MIMALLOC=0
%-sanitizer.o: %.c
	$(CC) $(CFLAGS) $(SANITIZER_FLAGS) -c -o $@ $<

# cJSON library (third-party) - build with relaxed warnings for sanitizer
src/lib/cjson/cJSON-sanitizer.o: src/lib/cjson/cJSON.c src/lib/cjson/cJSON.h
	$(CC) $(OPT) $(DEBUG) -fPIC -fno-omit-frame-pointer -fvisibility=hidden -Isrc $(SANITIZER_FLAGS) -c -o $@ $<

coverage: bin/moac-coverage

bin/moac-coverage: $(OBJS_COVERAGE) $(ASTONIA_NET_LIB)
	cp $(ASTONIA_NET_LIB) bin/
	$(CC) $(LDFLAGS) $(COVERAGE_FLAGS) -o bin/moac-coverage $(OBJS_COVERAGE) $(LIBS) -Lbin -lastonia_net

%-coverage.o: %.c
	$(CC) $(CFLAGS) $(COVERAGE_FLAGS) -c -o $@ $<

# cJSON library (third-party) - build with relaxed warnings for coverage
src/lib/cjson/cJSON-coverage.o: src/lib/cjson/cJSON.c src/lib/cjson/cJSON.h
	$(CC) $(OPT) $(DEBUG) -fPIC -fno-omit-frame-pointer -fvisibility=hidden -Isrc $(COVERAGE_FLAGS) -c -o $@ $<

# Convenience targets for build types
debug:
	$(MAKE) -f build/make/Makefile.linux BUILD_TYPE=debug

release:
	$(MAKE) -f build/make/Makefile.linux BUILD_TYPE=release

# Verify SDL3 is available (fails with helpful message if not found)
verify-sdl3:
	@if ! pkg-config --exists sdl3 2>/dev/null; then \
		echo ""; \
		echo "ERROR: SDL3 not found."; \
		echo ""; \
		echo "Please install SDL3 using your package manager. For example:"; \
		echo "  Ubuntu/Debian: sudo apt-get install libsdl3-dev"; \
		echo "  Fedora: sudo dnf install SDL3-devel"; \
		echo "  Arch: sudo pacman -S sdl3"; \
		echo ""; \
		echo "Alternatively, you can build from source using:"; \
		echo "  make build-sdl3"; \
		echo ""; \
		echo "Note: Using your package manager is usually recommended."; \
		echo ""; \
		exit 1; \
	fi

# Verify SDL3_mixer is available (fails with helpful message if not found)
verify-sdl3-mixer: verify-sdl3
	@if ! pkg-config --exists sdl3-mixer 2>/dev/null; then \
		echo ""; \
		echo "ERROR: SDL3_mixer not found."; \
		echo ""; \
		echo "Please install SDL3_mixer using your package manager. For example:"; \
		echo "  Ubuntu/Debian: sudo apt-get install libsdl3-mixer-dev"; \
		echo "  Fedora: sudo dnf install SDL3_mixer-devel"; \
		echo "  Arch: sudo pacman -S sdl3_mixer"; \
		echo ""; \
		echo "Alternatively, you can build from source using:"; \
		echo "  make build-sdl3-mixer"; \
		echo ""; \
		echo "Note: Using your package manager is usually recommended."; \
		echo "      SDL3_mixer requires SDL3 to be installed first."; \
		echo ""; \
		exit 1; \
	fi

# Build SDL3 from source (always builds, no detection)
# Installs to /usr/local (standard for Linux source builds)
build-sdl3:
	@echo "Building SDL3 from source..."
	@TMP_DIR=$${TMPDIR:-$${TMP:-/tmp}}; \
	BUILD_DIR=$$([ -d "$$TMP_DIR" ] && echo "$$TMP_DIR" || echo "/tmp"); \
	cd "$$BUILD_DIR" && \
		rm -rf SDL SDL-build && \
		git clone --depth 1 --branch release-3.4.14 https://github.com/libsdl-org/SDL.git SDL && \
		cmake -S SDL -B SDL-build \
			-DCMAKE_BUILD_TYPE=Release \
			-DCMAKE_INSTALL_PREFIX=/usr/local \
			-DSDL_STATIC=OFF && \
		cmake --build SDL-build && \
		sudo cmake --install SDL-build && \
		sudo ldconfig && \
		cd "$$BUILD_DIR" && \
		rm -rf SDL SDL-build && \
		echo "SDL3 installed to /usr/local"

# Build SDL3_mixer from source (always builds, no detection)
# Note: SDL3 must be installed first
# Installs to /usr/local (standard for Linux source builds)
SDL3_MIXER_VERSION ?= release-3.2.4
build-sdl3-mixer: verify-sdl3
	@echo "Building SDL3_mixer $(SDL3_MIXER_VERSION) from source..."
	@TMP_DIR=$${TMPDIR:-$${TMP:-/tmp}}; \
	BUILD_DIR=$$([ -d "$$TMP_DIR" ] && echo "$$TMP_DIR" || echo "/tmp"); \
	cd "$$BUILD_DIR" && \
		rm -rf SDL_mixer-$(SDL3_MIXER_VERSION) SDL_mixer-build && \
		curl -sL https://github.com/libsdl-org/SDL_mixer/archive/refs/tags/$(SDL3_MIXER_VERSION).tar.gz | tar xz && \
		cmake -S SDL_mixer-$(SDL3_MIXER_VERSION) -B SDL_mixer-build \
			-DCMAKE_BUILD_TYPE=Release \
			-DCMAKE_INSTALL_PREFIX=/usr/local \
			-DCMAKE_PREFIX_PATH=/usr/local \
			-DSDL3MIXER_VENDORED=ON && \
		cmake --build SDL_mixer-build && \
		sudo cmake --install SDL_mixer-build && \
		sudo ldconfig && \
		cd "$$BUILD_DIR" && \
		rm -rf SDL_mixer-$(SDL3_MIXER_VERSION) SDL_mixer-build && \
		echo "SDL3_mixer $(SDL3_MIXER_VERSION) installed to /usr/local"
